# CL Sniper v3.0 — Environment Variables
# Copy to .env and fill in your values

# Polygon wallet private key (required for live execution)
PRIVATE_KEY=0x...

# L2 API credentials (auto-derived from wallet if not provided)
CLOB_API_KEY=
CLOB_API_SECRET=
CLOB_PASSPHRASE=

# Optional overrides
# CLOB_API_URL=https://clob.polymarket.com
# NEG_RISK=true

# Logging (optional)
RUST_LOG=lag_scanner=info
