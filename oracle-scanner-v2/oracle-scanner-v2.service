[Unit]
Description=Oracle Scanner V2 — Polymarket Data Capture
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/user/Poly/oracle-scanner-v2
ExecStart=/home/user/Poly/oracle-scanner-v2/target/release/oracle_scanner_v2
Restart=always
RestartSec=5
Environment=RUST_LOG=oracle_scanner_v2=info

# All hardening removed — caused 226/NAMESPACE on this system

[Install]
WantedBy=multi-user.target
