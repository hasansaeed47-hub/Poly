# Sniper Final v1.0 — Environment Variables
#
# Two modes:
#   EOA mode:   Only PRIVATE_KEY needed. Funds must be in wallet address directly.
#   Proxy mode: Set POLY_FUNDER to use USDC deposited via Polymarket UI.
#               Also set CLOB_API_KEY/SECRET/PASSPHRASE from your Polymarket account.

PRIVATE_KEY=0x_your_polygon_private_key_here

# Proxy/funder address (from Polymarket UI — set this to use UI deposits)
# POLY_FUNDER=0x_your_polymarket_proxy_wallet_address

# API credentials (required for proxy mode, optional for EOA mode)
# CLOB_API_KEY=your-uuid-api-key
# CLOB_API_SECRET=your-base64-secret
# CLOB_PASSPHRASE=your-hex-passphrase

# Optional overrides (defaults to Polymarket mainnet)
# CLOB_API_URL=https://clob.polymarket.com

# Logging
RUST_LOG=sniper_final=info,test_order=info,check_approvals=info,set_approvals=info
